{
  "extends": "../../tsconfig.server.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // REQUIRED, and not redundant: `tsconfig.server.json` sets `"types": []`, which disables
    // automatic @types inclusion for every package extending it. This package imports
    // `node:crypto` (DealEntityServer.ts:54), so it must ask for node's types by name. It compiles
    // without this only under a HOISTED node_modules layout; a clean registry install fails with
    // TS2307 "Cannot find module 'node:crypto'". Measured against published packages.
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/__tests__/**"]
}
