{
  "name": "bizapps-sales",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "description": "BizApps Sales - deal pipeline management (accounts, contacts, pipelines, deals, deal teams, forecasting) built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "_comment_verify": [
    "ORDER IS LOAD-BEARING. Two gates IMPORT BUILD OUTPUT: assert-discount-conversion reads",
    "packages/Entities/dist/discount-conversion.js and assert-workspace-validation reads",
    "packages/Angular/dist/lib/workspace/deal-workspace.validation.js. They must run AFTER `build`.",
    "",
    "They used to run before it. On a tree that had never been built -- a fresh clone, or a worktree",
    "where nobody had run build yet -- verify died at the second gate on a missing or stale export,",
    "and every gate after it, including the spec typecheck, never ran at all. CI hid this because CI",
    "builds first; only local verify was wrong. That is this repo's THIRD stale-artefact incident and",
    "the first one inside a gate rather than a test.",
    "",
    "So: the four gates that read SOURCES run first and fail fast, then build, then the two that read",
    "dist. Adding a gate that imports from dist/ means adding it after `npm run build` here -- or",
    "better, making it read sources like the other four."
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/sales-entities\" --filter=\"@mj-biz-apps/sales-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/sales-*\"",
    "mj": "node node_modules/@memberjunction/cli/bin/run.js",
    "version": "changeset version",
    "mj:migrate": "node node_modules/@memberjunction/cli/bin/run.js migrate --schema __mj_BizAppsSales --dir ./migrations",
    "mj:codegen": "node node_modules/@memberjunction/cli/bin/run.js codegen",
    "mj:codegen:files": "node node_modules/@memberjunction/cli/bin/run.js codegen --skipdb",
    "postinstall": "node scripts/link-local-apps.mjs",
    "link:local": "node scripts/link-local-apps.mjs",
    "install:deps": "npm install",
    "setup": "echo 'Please run: npm run mj:migrate && npm run mj:codegen && npm run build'",
    "test:unit": "vitest run",
    "test:integration": "node test-harnesses/integration.mjs --mutations",
    "test:coverage-gate": "node scripts/assert-check-count.mjs",
    "test:vocabulary-gate": "node scripts/assert-no-vocabulary-comparisons.mjs",
    "test:money-gate": "node scripts/assert-no-money-arithmetic.mjs",
    "verify": "npm run test:vocabulary-gate && npm run test:money-gate && npm run test:drift-gate && npm run lint:distribution && npm run test:spec-gate && npm run build && npm run test:unit && npm run test:discount-gate && npm run test:validation-gate",
    "test:explorer:auth": "playwright test --config test-harnesses/playwright/playwright.config.ts --project auth-setup",
    "test:explorer": "playwright test --config test-harnesses/playwright/playwright.config.ts --project crud",
    "test:explorer:report": "playwright show-report test-harnesses/playwright/playwright-report",
    "test:discount-gate": "node scripts/assert-discount-conversion.mjs",
    "test:validation-gate": "node scripts/assert-workspace-validation.mjs",
    "test:spec-gate": "node scripts/assert-specs-typecheck.mjs",
    "test:drift-gate": "python scripts/assert-no-comment-drift.py",
    "change": "changeset",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "lint:distribution": "node scripts/check-distribution-seed.mjs",
    "check:release-seed": "node scripts/check-release-seed-coverage.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-sales"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@memberjunction/actions": "^6.1.0-edge.5",
    "@memberjunction/actions-base": "^6.1.0-edge.5",
    "@memberjunction/cli": "^6.1.0-edge.5",
    "@memberjunction/core": "^6.1.0-edge.5",
    "@memberjunction/core-entities": "^6.1.0-edge.5",
    "@memberjunction/core-entities-server": "^6.1.0-edge.5",
    "@memberjunction/generic-database-provider": "^6.1.0-edge.5",
    "@memberjunction/global": "^6.1.0-edge.5",
    "@memberjunction/graphql-dataprovider": "^6.1.0-edge.5",
    "@memberjunction/ng-base-forms": "^6.1.0-edge.5",
    "@memberjunction/ng-entity-viewer": "^6.1.0-edge.5",
    "@memberjunction/ng-link-directives": "^6.1.0-edge.5",
    "@memberjunction/ng-shared": "^6.1.0-edge.5",
    "@memberjunction/ng-shared-generic": "^6.1.0-edge.5",
    "@memberjunction/ng-ui-components": "^6.1.0-edge.5",
    "@memberjunction/server": "^6.1.0-edge.5",
    "@memberjunction/sqlserver-dataprovider": "^6.1.0-edge.5",
    "@memberjunction/testing-integration": "^6.1.0-edge.5",
    "@mj-biz-apps/sales-integration-tests": "workspace:*",
    "@mj-biz-apps/sales-server": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.20.1",
    "beasties": "0.3.5",
    "dotenv": "^17.2.3",
    "mrmime": "2.0.1",
    "mssql": "^11.0.1",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@angular/animations": "21.1.3",
      "@angular/build": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular-devkit/build-angular": "21.1.3",
      "@memberjunction/core": "^6.1.0-edge.5",
      "@memberjunction/global": "^6.1.0-edge.5",
      "graphql": "16.14.2",
      "type-graphql": "2.0.0-beta.3",
      "reflect-metadata": "0.2.2",
      "@types/node": "^22.20.1",
      "zod": "^3.25.76"
    }
  },
  "dependencies": {
    "@mj-biz-apps/orders-entities": "^5.2.1"
  }
}
