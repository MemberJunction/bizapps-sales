# bizapps-sales — template for the repo-root .env (gitignored).
# Copy it to .env and replace the placeholders. Never commit real values.
#
# Read by mj.config.cjs (the MJ CLI: mj migrate, mj codegen, mj sync, mj test), by scripts/*.sh (they
# source this file with bash) and by the test harnesses (through dotenv).
#
# Keep each comment on its own line: the Playwright cleanup script parses this file itself and does not
# strip a comment written after a value.

# ── Database ─────────────────────────────────────────────────────────────────────────────────────────

# SQL Server host.
DB_HOST=localhost
# SQL Server port.
DB_PORT=1433
# The database the CLI, the seeds and the harnesses use. scripts/rebuild-db.sh ignores it and drops
# only the database named in CONFIRM_DROP.
DB_DATABASE=your_database
# Login used by mj sync, mj test, scripts/*.sh and the harnesses.
DB_USERNAME=your_user
# Wrap it in single quotes if it contains `$`; bash would otherwise expand it.
DB_PASSWORD='your_password'
# true accepts a self-signed server certificate (a local SQL Server).
DB_TRUST_SERVER_CERTIFICATE=true
# MJ core schema name.
MJ_CORE_SCHEMA=__mj

# Login mj migrate and mj codegen connect with (read by the MJ CLI). The same login is fine locally.
CODEGEN_DB_USERNAME=your_user
CODEGEN_DB_PASSWORD='your_password'

# ── MJ core version (optional) ───────────────────────────────────────────────────────────────────────

# MJ core tag scripts/rebuild-db.sh installs. Unset, it uses the installed @memberjunction/cli version.
# It must satisfy mj-app.json's mjVersionRange and match the @memberjunction/* packages installed here.
# MJ_CORE_VERSION=v6.1.5

# ── CodeGen AI key (read by MJ's AI layer during mj codegen) ─────────────────────────────────────────

# Without a key CodeGen silently drops AI-written output (Validate*() methods, display names,
# descriptions, form layouts). Set one of these.
# AI_VENDOR_API_KEY__GeminiLLM=your_key
# AI_VENDOR_API_KEY__OpenRouterLLM=your_key

# ── Seeds and rebuilds ───────────────────────────────────────────────────────────────────────────────

# Email scripts/seed-dev-data.sh creates your MJ user and employee with. Falls back to git config
# user.email; an argument to the script wins over both.
# DEV_USER_EMAIL=you@example.com

# Sibling checkouts scripts/rebuild-db.sh migrates. Each defaults to ../bizapps-<name>.
# BIZAPPS_COMMON_REPO=../bizapps-common
# BIZAPPS_TASKS_REPO=../bizapps-tasks
# BIZAPPS_ACCOUNTING_REPO=../bizapps-accounting
# BIZAPPS_ORDERS_REPO=../bizapps-orders
# BIZAPPS_CONTRACTS_REPO=../bizapps-contracts

# ── Per-run switches ─────────────────────────────────────────────────────────────────────────────────
# Usually set on the command line for one run rather than here.

# The database scripts/rebuild-db.sh DROPS and recreates. No default: the script stops without it.
# CONFIRM_DROP=your_scratch_database

# 1 runs the integration checks that write (RequiresMutation); unset, they are skipped and the run
# fails. pnpm run test:integration and pnpm run test:coverage-gate set it for you.
# RUN_MUTATION_TESTS=1
# Where test-harnesses/integration.mjs writes its log. Default: test-harnesses/.integration-log.txt
# MJ_INTEGRATION_LOG=test-harnesses/.integration-log.txt
# How long a run waits for another run's suite lock, in milliseconds. Default: 900000 (15 minutes).
# MJ_INTEGRATION_LOCK_TIMEOUT_MS=900000
# 1 runs without loading orders' packages, to tell a handoff problem from a host-data problem.
# MJ_SKIP_DOWNSTREAM=1
# 1 lets a deliberately narrow run with skipped checks pass.
# MJ_ALLOW_SKIPPED=1
# Any value prints the stack of each failing check.
# IT_VERBOSE=1
# 1 makes test-harnesses/prove-order-at-creation.mjs run without orders' server classes.
# SKIP_ORDERS=1

# ── Explorer UI harness (test-harnesses/playwright) ──────────────────────────────────────────────────

# The host's MJAPI and MJExplorer ports. Defaults: 4143 and 4341.
# MJAPI_PORT=4143
# MJEXPLORER_PORT=4341
# Full URLs, when not http://localhost:<port>.
# MJAPI_URL=http://localhost:4143
# MJEXPLORER_URL=http://localhost:4341
# MJ API key the preflight uses to confirm MJAPI serves this app's metadata; skipped when unset.
# MJ_API_KEY=your_api_key
# 1 runs the browser headless.
# PW_HEADLESS=1
# Parallel workers. Default: 1.
# PW_WORKERS=1
# Milliseconds between browser actions, for watching a run.
# PW_SLOWMO=250
# 1 ignores the saved session and opens a headed login (use when auth-setup times out).
# PW_FORCE_LOGIN=1
# How long auth-setup waits for a human to log in, in milliseconds. Default: 300000.
# PW_LOGIN_TIMEOUT_MS=300000
# 1 lets auth-setup click an already-signed-in account tile; it never enters a password.
# PW_AUTH_ASSIST_PICK_ACCOUNT=1
# 1 turns off the ephemeral-workspace flag the harness sets in every page.
# PW_NO_EPHEMERAL=1
# 1 runs the diagnostic probe specs (01-03).
# PW_PROBE=1

# ── Set by CI or by another script; do not set them here ─────────────────────────────────────────────
# VERSION                            the release tag; publish.yml passes it to ci/commit_push.mjs
# CI                                 makes Playwright fail on a committed test.only
# MJ_INTEGRATION_LOCK_HELD_BY_PARENT set by test-harnesses/mutate-checks.mjs while it holds the suite
#                                    lock; set by hand, it disables the lock
