          }
        },
        {
          "fields": {
            "TourID": "@parent:ID",
            "StepKey": "closewon-branch",
            "Sequence": 3,
            "StepTypeID": "@lookup:MJ: Tour Step Types.Name=Choice",
            "Title": "Choose Your Close-Won Handoff Path",
            "Body": "Depending on your pipeline's `CloseWonPolicy`, closing creates contract paper plus billing schedules or transitions a direct order and locks forecast history.",
            "Configuration": {
              "Question": "Which close-won handoff path would you like to inspect?",
              "Options": [
                {
                  "Key": "contract-paper",
                  "Label": "Contracted Enterprise Deal",
                  "Description": "Generate executed contract paper + downstream billing schedule."
                },
                {
                  "Key": "direct-order",
                  "Label": "Direct Order & Forecast Capture",
                  "Description": "Create immediate order header and lock pipeline forecast snapshot."
                }
              ]
            },
            "Placement": "Center",
            "Mode": "Guide",
            "Completion": {
              "Type": "NextButton"
            },
            "OnMissing": "Center",
            "IsOptional": false
          },
          "primaryKey": {
            "ID": "08DE397B-4255-481F-88C2-87475D422799"
          }
        },
        {
          "fields": {
            "TourID": "@parent:ID",
            "StepKey": "closewon-contract-paper",
            "Sequence": 4,
            "StepTypeID": "@lookup:MJ: Tour Step Types.Name=Spotlight",
            "Title": "Handoff: Contract Generation & Lineage",
            "Body": "When `CloseWonPolicy` requires legal paper, `Sales.CloseDeal` provisions a linked **Contract** (`CreatingEntityID` / `CreatingRecordID` provenance pointing back to the deal) and queues follow-up tasks alongside the downstream billing schedule.",
            "Configuration": {
              "ShowProgress": true
            },
            "Anchor": {
              "Strategy": "Registered",
              "Key": "sales.dashboard.kpis"
            },
            "Placement": "Bottom",
            "Mode": "Guide",
            "Completion": {
