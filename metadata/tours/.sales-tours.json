            "IsOptional": false
          },
          "primaryKey": {
            "ID": "6EF01FBE-F531-49EE-A8BD-CA94CE278253"
          }
        },
        {
          "fields": {
            "TourID": "@parent:ID",
            "StepKey": "closewon-direct-order",
            "Sequence": 5,
            "StepTypeID": "@lookup:MJ: Tour Step Types.Name=Spotlight",
            "Title": "Handoff: Direct Order & Forecast Snapshots",
            "Body": "For direct-order pipelines, `Sales.CloseDeal` advances the linked **Order Header** according to `PipelineStage.OrderStatusOnEntry` while **Forecast Snapshots** preserve point-in-time Commit, Best case, and Won rollups.",
            "Configuration": {
              "ShowProgress": true
