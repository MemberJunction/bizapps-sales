            "StepTypeID": "@lookup:MJ: Tour Step Types.Name=Spotlight",
            "Title": "Atomic Deal Close via Sales.CloseDeal",
            "Body": "`Sales.CloseDeal` resolves the pipeline's `CloseWonPolicy` and `DealStatusType` flags (`IsWon`, `IsLost`, `LocksDeal`) in one transaction. If a locked deal ever needs revision, `Sales.ReopenDeal` records a mandatory reason and stage audit event.",
            "Configuration": {
              "ShowProgress": true
            },
            "Anchor": {
              "Strategy": "Registered",
              "Key": "sales.dashboard.forecast"
            },
            "Placement": "Bottom",
            "Mode": "Guide",
            "Completion": {
